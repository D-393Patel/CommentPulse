{
  "manifest_version": 3,
  "name": "YouTube Sentiment Insights",
  "version": "1.0.5",
  "description": "Analyze YouTube comment sentiment, themes, and explainable AI-content likelihood signals.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*",
    "https://*.trycloudflare.com/*",
    "https://commentpulse-api.onrender.com/*"
  ],
  "icons": {
    "128": "icon128.png"
  }
}
